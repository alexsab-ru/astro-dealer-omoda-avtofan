---
import Layout from '@/layouts/Layout.astro';
import Banner from '@/components/Banner/Banner.astro';
import InfoSectionWithImage from '@/components/InfoSectionWithImage/InfoSectionWithImage.astro';
import settings from '@/data/settings.json';
const { brand, legal_city_where } = settings;
const banner = [
	{
		"show": true,
		"type": "image",
		"imageUrl": "https://cdn.alexsab.ru/pages/omoda/about/banner_desktop.webp",
		"mobileImageUrl": "https://cdn.alexsab.ru/pages/omoda/about/banner_mobile.webp",
		"title": "<h1 class=\"pt-10 font-normal\">Бренд OMODA</h1>",
	}
];
---

<Layout title="Бренд OMODA" description="Готовы погрузиться в будущее? Добро пожаловать в Мультивселенную OMODA! Здесь вы познакомитесь с новинками бренда через технологию дополненной реальности." image="https://cdn.alexsab.ru/pages/omoda/about/banner_desktop.webp">
	<Banner banners={banner} />
	<section class="-my-14 content">
		<h2 class="sr-only !absolute !w-1">Информация о Бренде</h2>
		<div class="container">
			<InfoSectionWithImage image={{
				desktop: 'https://cdn.alexsab.ru/pages/omoda/about/1.webp',
			}}>
				<h3 class="font-bold mb-8">О бренде</h3>
				<div class="space-y-5">
					<p>В названии бренда зашифрованы два элемента, отражающие основной подход OMODA — создавать продукцию, полностью соответствующую потребностям современного пользователя. «O» (oxygen — кислород) символизирует свежесть и энергию, а «MODA» (modern — современный) — моду и тренды как неотъемлемую часть жизни сегодняшнего человека.Фирменный стиль и одновременно ДНК OMODA — это нестандартный подход, модный дизайн, актуальные тренды и передовые технологии, а также забота об устойчивом будущем.</p>
					<p>Бренд OMODA — это особая философия и целая вселенная O-Universe, где объединились:</p>
					<ul>
						<li>собственное комьюнити (O-Club),</li>
						<li>неординарный подход к образу жизни (O-Life),</li>
						<li>оригинальный модный дизайн (O-Style),</li>
						<li>и инновационные технологии (O-Tech).</li>
					</ul>
					<p>Станьте частью вселенной OMODA!</p>
				</div>
			</InfoSectionWithImage>
			<InfoSectionWithImage image={{
				desktop: 'https://cdn.alexsab.ru/pages/omoda/about/2.webp',
			}}>
				<h3 class="font-bold mb-8">Награды</h3>
				<div class="space-y-5">
					<p>OMODA C5 удостоен звания «Автомобиль года 2024» за прорывные технологии и премиальный комфорт, а новый OMODA C7 стал победителем премии VOICE 2025 в номинации «Дизайн года».</p>
				</div>
			</InfoSectionWithImage>

			<!-- 
			TODO: создать коллекцию tekhnologii 
			все данные будут браться из https://omoda.ru/omoda/tekhnologii/
			-->

			<!-- <InfoSectionWithImage image={{
				desktop: 'https://cdn.alexsab.ru/pages/omoda/about/3.webp',
			}}>
				<h3 class="font-bold mb-8">Технологии</h3>
				<div class="space-y-5">
					<p>OMODA — это гармония стиля, инноваций и комфорта.</p>
					<a href="/tekhnologii/" class="btn btn-o">Подробнее</a>
				</div>
			</InfoSectionWithImage> -->

			<InfoSectionWithImage image={{
				desktop: 'https://cdn.alexsab.ru/pages/omoda/about/4.webp',
			}}>
				<h3 class="font-bold mb-8">Новости</h3>
				<div class="space-y-5">
					<a href="/news/" class="btn btn-o">Подробнее</a>
				</div>
			</InfoSectionWithImage>
			<InfoSectionWithImage image={{
				desktop: 'https://cdn.alexsab.ru/pages/omoda/about/5.webp',
			}}>
				<h3 class="font-bold mb-8">Правовая информация</h3>
				<div class="space-y-5">
					<a href="/privacy-policy/" class="btn btn-o">Подробнее</a>
				</div>
			</InfoSectionWithImage>
		</div>
	</section>
</Layout>